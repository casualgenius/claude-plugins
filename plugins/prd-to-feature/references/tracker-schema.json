{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature Workflow Task Tracker",
  "description": "Schema for tracking tasks in the prd-to-feature development process",
  "type": "object",
  "required": ["feature", "implementationDoc", "phases", "tasks"],
  "properties": {
    "feature": {
      "type": "string",
      "description": "Name of the feature being implemented"
    },
    "implementationDoc": {
      "type": "string",
      "description": "Path to the implementation.md file (typically .prd-to-feature/{feature-name}/implementation.md)"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the tracker was created"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the tracker was last updated"
    },
    "phases": {
      "type": "array",
      "description": "Implementation phases for organizing tasks",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^phase-[0-9]+$",
            "description": "Unique phase identifier (e.g., phase-1, phase-2)"
          },
          "name": {
            "type": "string",
            "description": "Human-readable phase name"
          },
          "description": {
            "type": "string",
            "description": "Description of the phase goals"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "description": "List of implementation tasks",
      "items": {
        "type": "object",
        "required": ["id", "title", "phase", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^task-[0-9]{3}$",
            "description": "Unique task identifier (e.g., task-001, task-002)"
          },
          "title": {
            "type": "string",
            "description": "Brief descriptive title for the task"
          },
          "phase": {
            "type": "string",
            "description": "Phase ID this task belongs to"
          },
          "status": {
            "type": "string",
            "enum": ["todo", "in-progress", "blocked", "done"],
            "description": "Current status of the task"
          },
          "dependsOn": {
            "type": "array",
            "description": "Task IDs that must be completed before this task can start",
            "items": {
              "type": "string",
              "pattern": "^task-[0-9]{3}$"
            },
            "default": []
          },
          "notes": {
            "type": "array",
            "description": "Developer notes added during implementation",
            "items": {
              "type": "object",
              "required": ["timestamp", "content"],
              "properties": {
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                },
                "content": {
                  "type": "string"
                },
                "addedBy": {
                  "type": "string",
                  "description": "Identifier of who added the note (task ID or 'user')"
                }
              }
            },
            "default": []
          },
          "complexity": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "Estimated complexity of the task"
          },
          "filesModified": {
            "type": "array",
            "description": "List of files modified during implementation (populated when done)",
            "items": {
              "type": "string"
            }
          },
          "currentIteration": {
            "type": "integer",
            "description": "Current ralph loop iteration (1-indexed). Used to resume after session interruption. Cleared when task is marked done.",
            "minimum": 1
          },
          "commits": {
            "type": "array",
            "description": "Git commit history for this task across iterations",
            "items": {
              "type": "object",
              "required": ["hash", "iteration"],
              "properties": {
                "hash": {
                  "type": "string",
                  "description": "Git commit hash (short form)"
                },
                "iteration": {
                  "type": "integer",
                  "description": "Ralph loop iteration number (1-indexed), or 1 for non-ralph develop"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO 8601 timestamp when commit was made"
                }
              }
            },
            "default": []
          },
          "skillHints": {
            "type": "array",
            "description": "Exact names of skills the planner identified as relevant to this task, as they appear in the Skill tool (e.g. 'python-development:python-testing-patterns'). Advisory only: the developer agent sees the full skill list itself, may invoke skills not listed here, and ignores any hint that is no longer installed. Leave empty rather than guessing; never use invented category labels.",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    }
  },
  "examples": [
    {
      "feature": "User Authentication",
      "implementationDoc": ".prd-to-feature/user-auth/implementation.md",
      "createdAt": "2025-01-15T10:00:00Z",
      "phases": [
        {
          "id": "phase-1",
          "name": "Foundation",
          "description": "Set up authentication infrastructure"
        },
        {
          "id": "phase-2",
          "name": "Implementation",
          "description": "Implement login and signup flows"
        }
      ],
      "tasks": [
        {
          "id": "task-001",
          "title": "Set up authentication provider",
          "phase": "phase-1",
          "status": "done",
          "dependsOn": [],
          "notes": [],
          "complexity": "low",
          "filesModified": ["lib/auth/client.ts", ".env.example"],
          "commits": [
            {"hash": "abc123", "iteration": 1, "timestamp": "2025-01-15T10:30:00Z"}
          ]
        },
        {
          "id": "task-002",
          "title": "Create login form component",
          "phase": "phase-2",
          "status": "in-progress",
          "dependsOn": ["task-001"],
          "notes": [
            {
              "timestamp": "2025-01-15T11:30:00Z",
              "content": "Using react-hook-form with zod schema for validation",
              "addedBy": "task-001"
            }
          ],
          "complexity": "medium",
          "skillHints": ["frontend-mobile-development:react-state-management"]
        }
      ]
    }
  ]
}
